# JIMDUR ERP en Vercel + Neon — valores de ejemplo; no uses estos valores en producción.

# Cadena de conexión PostgreSQL creada en Neon.
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# URL pública de Vercel; se usa para metadatos y enlaces del instalador.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto usado como material adicional para PBKDF2. Genera uno nuevo y privado.
JIMDUR_AUTH_SECRET=replace-with-a-long-random-secret

# SHA-256 hexadecimal del código normalizado de activación inicial.
JIMDUR_SETUP_CODE_HASH=replace-with-sha256-of-setup-code

# Recuperación temporal opcional. Déjalo vacío si no se usa.
JIMDUR_PASSWORD_RECOVERY_CODE_HASH=
JIMDUR_PASSWORD_RECOVERY_USERNAME=ADMIN
JIMDUR_PASSWORD_RECOVERY_EXPIRES_AT=2026-12-31T23:59:59Z
