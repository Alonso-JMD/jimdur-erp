{
  "name": "jimdur-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "predev": "npm run prepare:pdf-worker",
    "dev": "next dev",
    "prebuild": "npm run prepare:pdf-worker",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern archive --ignore-pattern public/pdf.worker.min.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/neon-migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-neon.mjs",
    "db:setup": "npm run db:migrate && npm run db:import",
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "0.45.2",
    "mammoth": "^1.10.0",
    "next": "16.2.6",
    "pdfjs-dist": "^5.4.149",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^6.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "JIMDUR ERP"
}
